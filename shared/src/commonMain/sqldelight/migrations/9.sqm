-- The answers to "ease back in?" after a break sync, so every device plans the same lighter
-- workouts. They say only that there was a break and how long, not why.
DROP TRIGGER sync_setting_insert;
DROP TRIGGER sync_setting_update;

CREATE TRIGGER sync_setting_insert AFTER INSERT ON setting
WHEN new.key IN ('weight_unit', 'bar_weight_kg', 'auto_warmups', 'goal_profile', 'active_program', 'onboarding_done', 'program_starts', 'focus_areas', 'comebacks') BEGIN
  INSERT OR REPLACE INTO sync_change(kind, id, changed_at, deleted) VALUES ('setting', new.key, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'), 0);
END;
CREATE TRIGGER sync_setting_update AFTER UPDATE ON setting
WHEN new.key IN ('weight_unit', 'bar_weight_kg', 'auto_warmups', 'goal_profile', 'active_program', 'onboarding_done', 'program_starts', 'focus_areas', 'comebacks') BEGIN
  INSERT OR REPLACE INTO sync_change(kind, id, changed_at, deleted) VALUES ('setting', new.key, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'), 0);
END;
