CREATE TABLE sync_change (
  kind TEXT NOT NULL,
  id TEXT NOT NULL,
  changed_at TEXT NOT NULL,
  deleted INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (kind, id)
);

CREATE TABLE sync_state (
  key TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);

CREATE TRIGGER sync_session_insert AFTER INSERT ON session BEGIN
  INSERT OR REPLACE INTO sync_change(kind, id, changed_at, deleted) VALUES ('session', new.id, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'), 0);
END;
CREATE TRIGGER sync_session_update AFTER UPDATE ON session BEGIN
  INSERT OR REPLACE INTO sync_change(kind, id, changed_at, deleted) VALUES ('session', new.id, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'), 0);
END;
CREATE TRIGGER sync_session_delete AFTER DELETE ON session BEGIN
  INSERT OR REPLACE INTO sync_change(kind, id, changed_at, deleted) VALUES ('session', old.id, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'), 1);
END;
CREATE TRIGGER sync_entry_insert AFTER INSERT ON exercise_entry BEGIN
  INSERT OR REPLACE INTO sync_change(kind, id, changed_at, deleted) VALUES ('session', new.session_id, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'), 0);
END;
CREATE TRIGGER sync_entry_update AFTER UPDATE ON exercise_entry BEGIN
  INSERT OR REPLACE INTO sync_change(kind, id, changed_at, deleted) VALUES ('session', new.session_id, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'), 0);
END;
CREATE TRIGGER sync_entry_delete AFTER DELETE ON exercise_entry BEGIN
  INSERT OR REPLACE INTO sync_change(kind, id, changed_at, deleted) VALUES ('session', old.session_id, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'), 0);
END;
CREATE TRIGGER sync_set_insert AFTER INSERT ON set_entry BEGIN
  INSERT OR REPLACE INTO sync_change(kind, id, changed_at, deleted)
  SELECT 'session', session_id, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'), 0 FROM exercise_entry WHERE id = new.entry_id;
END;
CREATE TRIGGER sync_set_update AFTER UPDATE ON set_entry BEGIN
  INSERT OR REPLACE INTO sync_change(kind, id, changed_at, deleted)
  SELECT 'session', session_id, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'), 0 FROM exercise_entry WHERE id = new.entry_id;
END;
CREATE TRIGGER sync_set_delete AFTER DELETE ON set_entry BEGIN
  INSERT OR REPLACE INTO sync_change(kind, id, changed_at, deleted)
  SELECT 'session', session_id, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'), 0 FROM exercise_entry WHERE id = old.entry_id;
END;
