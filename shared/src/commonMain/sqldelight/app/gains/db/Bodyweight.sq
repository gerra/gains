CREATE TABLE bodyweight (
  date TEXT NOT NULL PRIMARY KEY,
  weight_kg REAL NOT NULL,
  source TEXT NOT NULL DEFAULT 'manual'
);

selectAll:
SELECT date, weight_kg, source FROM bodyweight ORDER BY date;

upsert:
INSERT OR REPLACE INTO bodyweight(date, weight_kg, source) VALUES (?, ?, ?);

delete:
DELETE FROM bodyweight WHERE date = ?;
