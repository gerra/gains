// Settings shared by every build of the iOS app. The Xcode project reads them through
// $(NAME) so nothing here has to be edited inside Xcode.

// Apple Developer team that signs the app (Xcode > Settings > Accounts shows it).
TEAM_ID=V5Y8M5GKZ6
BUNDLE_ID=app.gains.Gains
APP_NAME=Gains

// Version shown in TestFlight and the App Store (CFBundleShortVersionString). On main this
// is the last version released; the daily "Cut release branch" workflow bumps the minor on
// each release/<major>.<minor> branch and the release pull request brings it back here. To
// start a new major, run that workflow by hand with the version (docs/testflight.md).
MARKETING_VERSION=1.4
// Build number (CFBundleVersion). App Store Connect rejects an upload that reuses a build
// number for the same version, so bump it before every TestFlight upload. The Release and
// TestFlight workflows override it with their GitHub run number;
// `xcodebuild ... CURRENT_PROJECT_VERSION=42` does the same by hand.
CURRENT_PROJECT_VERSION=1

// The sync server (docs/sync.md), read by the app through GainsServerURL in Info.plist. The
// empty $() is there because xcconfig treats // as the start of a comment, even inside a value.
GAINS_SERVER_URL = https:/$()/api.gains.gerra.sh

// The iOS OAuth client from the Google Cloud console (APIs & Services > Credentials), read by
// the app through GainsGoogleClientID in Info.plist. Not a secret: it ships inside every copy of
// the app. Google redirects back to its reversed form,
// com.googleusercontent.apps.95741411455-2fouqgkjlnault5cvd8lc17n4jekg7ea. Empty disables the
// Google button.
GOOGLE_IOS_CLIENT_ID = 95741411455-2fouqgkjlnault5cvd8lc17n4jekg7ea.apps.googleusercontent.com
