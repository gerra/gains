<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- The watch app's own strings (Localizable.xcstrings), in the iPhone app's two languages. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ru</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>$(APP_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<!-- Both from Configuration/Config.xcconfig, like the iPhone app's: App Store Connect rejects a
	     watch app whose version or build differs from the app it ships in. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- A watch app that ships inside the iPhone app and needs it (docs/watch.md): it shows the
	     workout running on the phone and has nothing to show without one. -->
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>$(BUNDLE_ID)</string>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<false/>
	<!-- The Health workout keeps the app running through a workout: on the wrist when it is raised,
	     and able to tap at the end of a rest with the wrist down. -->
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>Gains reads your heart rate and the energy you burn during a workout to show them on your wrist.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Gains saves your strength workouts to Health, so they count towards your Activity rings.</string>
</dict>
</plist>
