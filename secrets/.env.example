# Copy to secrets/.env, fill in, then deploy with python3 tools/deploy_server.py secrets.
# See secrets/README.md for what each var is and how to generate it.

JWT_SECRET=
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=app.gains.Gains
# Sign in with Apple on Android and the desktop; empty turns that flow off.
APPLE_SERVICES_ID=
# The Sign in with Apple key that revokes a deleted account's tokens: all three or none.
# APPLE_TEAM_ID is V5Y8M5GKZ6; APPLE_PRIVATE_KEY is the .p8 on one line, newlines as \n.
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY=
# Email and password accounts: the SMTP submission account their confirmation and reset mails
# go out through, and the address they come from. SMTP_HOST and MAIL_FROM together or neither;
# SMTP_USER and SMTP_PASSWORD together or neither. Port 465 is TLS from the start, anything else
# STARTTLS (587 is the usual). Empty turns email sign-in off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Passkeys: origins the Android app's passkeys come from besides https://gains.gerra.sh, comma
# separated, one per key the app is signed with: android:apk-key-hash:<base64url SHA-256>.
# Empty accepts passkeys from iOS only.
PASSKEY_ORIGINS=
GAINS_DATA_DIR=/var/lib/gains
PORT=5003
