# Copy to secrets/.env, fill in, then deploy with python3 tools/deploy_server.py secrets.
# See secrets/README.md for what each var is and how to generate it.

JWT_SECRET=
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=app.gains.Gains
# The Sign in with Apple key that revokes a deleted account's tokens: all three or none.
# APPLE_TEAM_ID is V5Y8M5GKZ6; APPLE_PRIVATE_KEY is the .p8 on one line, newlines as \n.
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY=
GAINS_DATA_DIR=/var/lib/gains
PORT=5003
