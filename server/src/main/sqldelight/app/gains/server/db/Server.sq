-- The sync server's tables (docs/sync.md, "The server"). One SQLite file per box; every row
-- but the guest list's belongs to a user, and nothing is shared between users.

CREATE TABLE user (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  email TEXT,
  name TEXT,
  created_at TEXT NOT NULL
);

-- A sign-in provider's stable subject, pointing at the user it belongs to. The same person
-- with both providers has two rows here and one in `user`. `email_verified` is the provider's
-- word that the address belongs to this person; only such an email may join two identities
-- (migrations/1.sqm). `refresh_token` is Apple's, from the code the app sent at its latest
-- sign-in, kept only so deleting the account can revoke it; `refresh_client_id` is the client id
-- it was issued to (migrations/2.sqm). With `REFRESH_TOKEN_KEY` set, `refresh_token` is `v1:`
-- ciphertext (RefreshTokenCipher); a value without the prefix is plain text from before.
CREATE TABLE identity (
  provider TEXT NOT NULL,
  subject TEXT NOT NULL,
  user_id INTEGER NOT NULL REFERENCES user(id),
  email TEXT,
  email_verified INTEGER NOT NULL DEFAULT 0,
  refresh_token TEXT,
  refresh_client_id TEXT,
  PRIMARY KEY (provider, subject)
);

CREATE INDEX identity_user ON identity(user_id);

-- One synced thing in its latest state. `seq` is the feed position; an overwrite takes a new one.
CREATE TABLE document (
  user_id INTEGER NOT NULL,
  kind TEXT NOT NULL,
  id TEXT NOT NULL,
  seq INTEGER NOT NULL,
  updated_at TEXT NOT NULL,
  deleted INTEGER NOT NULL DEFAULT 0,
  payload TEXT NOT NULL DEFAULT '',
  PRIMARY KEY (user_id, kind, id)
);

CREATE INDEX document_feed ON document(user_id, seq);

-- The bytes behind a `session_photo` document; the feed row carries only their hash and size.
CREATE TABLE blob (
  user_id INTEGER NOT NULL,
  kind TEXT NOT NULL,
  id TEXT NOT NULL,
  bytes BLOB NOT NULL,
  PRIMARY KEY (user_id, kind, id)
);

-- The one counter every accepted write takes its `seq` from.
CREATE TABLE counter (
  name TEXT NOT NULL PRIMARY KEY,
  value INTEGER NOT NULL
);

INSERT INTO counter(name, value) VALUES ('seq', 0);

-- Addresses left on gains.gerra.sh to hear when Gains launches (migrations/3.sqm). Not tied to
-- a user; one row per address, whatever its case.
CREATE TABLE guest_list (
  email TEXT NOT NULL PRIMARY KEY COLLATE NOCASE,
  created_at TEXT NOT NULL
);

-- An email and password sign-up (migrations/4.sqm). `user_id` is null until the address is
-- confirmed; confirming it creates an `identity` row with provider `password` and the address
-- as subject, which is what joins or creates the user, so that the verified-email rule above
-- decides the merge. The hash is Argon2id in PHC form (PasswordHasher).
CREATE TABLE password_credential (
  email TEXT NOT NULL PRIMARY KEY COLLATE NOCASE,
  hash TEXT NOT NULL,
  user_id INTEGER REFERENCES user(id),
  created_at TEXT NOT NULL
);

CREATE INDEX password_credential_user ON password_credential(user_id);

-- The one-time links sent by mail: the SHA-256 of the token in the link, never the token itself,
-- what it is for (`verify` or `reset`), the address it went to and when it expires (epoch
-- milliseconds). Taking a token deletes it.
CREATE TABLE email_token (
  token_hash TEXT NOT NULL PRIMARY KEY,
  email TEXT NOT NULL COLLATE NOCASE,
  purpose TEXT NOT NULL,
  expires_at INTEGER NOT NULL
);

CREATE INDEX email_token_email ON email_token(email);

-- users and identities

selectIdentity:
SELECT provider, subject, user_id, email, email_verified FROM identity WHERE provider = ? AND subject = ?;

-- The user one of whose identities has this email, verified by its provider. Both sides must be
-- verified: an unverified address on the existing identity could have been typed by anyone.
selectUserIdByVerifiedEmail:
SELECT user_id FROM identity WHERE email = ? COLLATE NOCASE AND email_verified = 1 ORDER BY user_id LIMIT 1;

selectUser:
SELECT id, email, name, created_at FROM user WHERE id = ?;

insertUser:
INSERT INTO user(email, name, created_at) VALUES (?, ?, ?);

lastInsertedId:
SELECT last_insert_rowid();

insertIdentity:
INSERT INTO identity(provider, subject, user_id, email, email_verified) VALUES (?, ?, ?, ?, ?);

updateIdentityEmail:
UPDATE identity SET email = ?, email_verified = ? WHERE provider = ? AND subject = ?;

updateUserDetails:
UPDATE user SET email = COALESCE(email, ?), name = COALESCE(name, ?) WHERE id = ?;

updateIdentityRefreshToken:
UPDATE identity SET refresh_token = ?, refresh_client_id = ? WHERE provider = ? AND subject = ?;

selectRefreshTokensForUser:
SELECT refresh_token, refresh_client_id FROM identity
WHERE user_id = ? AND provider = ? AND refresh_token IS NOT NULL AND refresh_client_id IS NOT NULL;

selectAllRefreshTokens:
SELECT provider, subject, refresh_token FROM identity WHERE refresh_token IS NOT NULL;

updateIdentityRefreshTokenOnly:
UPDATE identity SET refresh_token = ? WHERE provider = ? AND subject = ? AND refresh_token = ?;

selectProvidersForUser:
SELECT provider FROM identity WHERE user_id = ? ORDER BY provider;

deleteIdentitiesForUser:
DELETE FROM identity WHERE user_id = ?;

-- password credentials and the links mailed for them

selectCredential:
SELECT email, hash, user_id, created_at FROM password_credential WHERE email = ?;

insertCredential:
INSERT INTO password_credential(email, hash, created_at) VALUES (?, ?, ?);

updateCredentialHash:
UPDATE password_credential SET hash = ? WHERE email = ?;

updateCredentialUser:
UPDATE password_credential SET user_id = ? WHERE email = ?;

selectCredentialEmailsForUser:
SELECT email FROM password_credential WHERE user_id = ?;

deleteCredentialsForUser:
DELETE FROM password_credential WHERE user_id = ?;

insertEmailToken:
INSERT INTO email_token(token_hash, email, purpose, expires_at) VALUES (?, ?, ?, ?);

selectEmailToken:
SELECT token_hash, email, purpose, expires_at FROM email_token WHERE token_hash = ?;

deleteEmailToken:
DELETE FROM email_token WHERE token_hash = ?;

deleteEmailTokensForEmail:
DELETE FROM email_token WHERE email = ?;

deleteEmailTokensForPurpose:
DELETE FROM email_token WHERE email = ? AND purpose = ?;

deleteExpiredEmailTokens:
DELETE FROM email_token WHERE expires_at <= ?;

deleteUser:
DELETE FROM user WHERE id = ?;

-- documents

-- Bumped and read as a pair, inside the transaction that uses the value.
incrementSeq:
UPDATE counter SET value = value + 1 WHERE name = 'seq';

selectSeq:
SELECT value FROM counter WHERE name = 'seq';

selectDocument:
SELECT user_id, kind, id, seq, updated_at, deleted, payload FROM document WHERE user_id = ? AND kind = ? AND id = ?;

upsertDocument:
INSERT OR REPLACE INTO document(user_id, kind, id, seq, updated_at, deleted, payload) VALUES (?, ?, ?, ?, ?, ?, ?);

selectFeed:
SELECT user_id, kind, id, seq, updated_at, deleted, payload FROM document WHERE user_id = ? AND seq > ? ORDER BY seq LIMIT ?;

countDocumentsForUser:
SELECT COUNT(*) FROM document WHERE user_id = ?;

deleteDocumentsForUser:
DELETE FROM document WHERE user_id = ?;

-- blobs

selectBlob:
SELECT bytes FROM blob WHERE user_id = ? AND kind = ? AND id = ?;

upsertBlob:
INSERT OR REPLACE INTO blob(user_id, kind, id, bytes) VALUES (?, ?, ?, ?);

deleteBlob:
DELETE FROM blob WHERE user_id = ? AND kind = ? AND id = ?;

-- What the user's other blobs take, for the per-user ceiling: the one about to be replaced is left
-- out. length() reads the size from the row header, not the bytes.
sumOtherBlobBytesForUser:
SELECT COALESCE(SUM(length(bytes)), 0) FROM blob WHERE user_id = ? AND (kind != ? OR id != ?);

deleteBlobsForUser:
DELETE FROM blob WHERE user_id = ?;

-- guest list

insertGuest:
INSERT OR IGNORE INTO guest_list(email, created_at) VALUES (?, ?);

selectGuest:
SELECT email FROM guest_list WHERE email = ?;

countGuests:
SELECT COUNT(*) FROM guest_list;
