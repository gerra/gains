-- The sync server's five tables (docs/sync.md, "The server"). One SQLite file per box; every
-- row belongs to a user and nothing is shared between users.

CREATE TABLE user (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  email TEXT,
  name TEXT,
  created_at TEXT NOT NULL
);

-- A sign-in provider's stable subject, pointing at the user it belongs to. The same person
-- with both providers has two rows here and one in `user`. `email_verified` is the provider's
-- word that the address belongs to this person; only such an email may join two identities
-- (migrations/1.sqm). `refresh_token` is Apple's, from the code the app sent at its latest
-- sign-in, kept only so deleting the account can revoke it; `refresh_client_id` is the client id
-- it was issued to (migrations/2.sqm).
CREATE TABLE identity (
  provider TEXT NOT NULL,
  subject TEXT NOT NULL,
  user_id INTEGER NOT NULL REFERENCES user(id),
  email TEXT,
  email_verified INTEGER NOT NULL DEFAULT 0,
  refresh_token TEXT,
  refresh_client_id TEXT,
  PRIMARY KEY (provider, subject)
);

CREATE INDEX identity_user ON identity(user_id);

-- One synced thing in its latest state. `seq` is the feed position; an overwrite takes a new one.
CREATE TABLE document (
  user_id INTEGER NOT NULL,
  kind TEXT NOT NULL,
  id TEXT NOT NULL,
  seq INTEGER NOT NULL,
  updated_at TEXT NOT NULL,
  deleted INTEGER NOT NULL DEFAULT 0,
  payload TEXT NOT NULL DEFAULT '',
  PRIMARY KEY (user_id, kind, id)
);

CREATE INDEX document_feed ON document(user_id, seq);

-- The bytes behind a `session_photo` document; the feed row carries only their hash and size.
CREATE TABLE blob (
  user_id INTEGER NOT NULL,
  kind TEXT NOT NULL,
  id TEXT NOT NULL,
  bytes BLOB NOT NULL,
  PRIMARY KEY (user_id, kind, id)
);

-- The one counter every accepted write takes its `seq` from.
CREATE TABLE counter (
  name TEXT NOT NULL PRIMARY KEY,
  value INTEGER NOT NULL
);

INSERT INTO counter(name, value) VALUES ('seq', 0);

-- users and identities

selectIdentity:
SELECT provider, subject, user_id, email, email_verified FROM identity WHERE provider = ? AND subject = ?;

-- The user one of whose identities has this email, verified by its provider. Both sides must be
-- verified: an unverified address on the existing identity could have been typed by anyone.
selectUserIdByVerifiedEmail:
SELECT user_id FROM identity WHERE email = ? COLLATE NOCASE AND email_verified = 1 ORDER BY user_id LIMIT 1;

selectUser:
SELECT id, email, name, created_at FROM user WHERE id = ?;

insertUser:
INSERT INTO user(email, name, created_at) VALUES (?, ?, ?);

lastInsertedId:
SELECT last_insert_rowid();

insertIdentity:
INSERT INTO identity(provider, subject, user_id, email, email_verified) VALUES (?, ?, ?, ?, ?);

updateIdentityEmail:
UPDATE identity SET email = ?, email_verified = ? WHERE provider = ? AND subject = ?;

updateUserDetails:
UPDATE user SET email = COALESCE(email, ?), name = COALESCE(name, ?) WHERE id = ?;

updateIdentityRefreshToken:
UPDATE identity SET refresh_token = ?, refresh_client_id = ? WHERE provider = ? AND subject = ?;

selectRefreshTokensForUser:
SELECT refresh_token, refresh_client_id FROM identity
WHERE user_id = ? AND provider = ? AND refresh_token IS NOT NULL AND refresh_client_id IS NOT NULL;

selectProvidersForUser:
SELECT provider FROM identity WHERE user_id = ? ORDER BY provider;

deleteIdentitiesForUser:
DELETE FROM identity WHERE user_id = ?;

deleteUser:
DELETE FROM user WHERE id = ?;

-- documents

-- Bumped and read as a pair, inside the transaction that uses the value.
incrementSeq:
UPDATE counter SET value = value + 1 WHERE name = 'seq';

selectSeq:
SELECT value FROM counter WHERE name = 'seq';

selectDocument:
SELECT user_id, kind, id, seq, updated_at, deleted, payload FROM document WHERE user_id = ? AND kind = ? AND id = ?;

upsertDocument:
INSERT OR REPLACE INTO document(user_id, kind, id, seq, updated_at, deleted, payload) VALUES (?, ?, ?, ?, ?, ?, ?);

selectFeed:
SELECT user_id, kind, id, seq, updated_at, deleted, payload FROM document WHERE user_id = ? AND seq > ? ORDER BY seq LIMIT ?;

countDocumentsForUser:
SELECT COUNT(*) FROM document WHERE user_id = ?;

deleteDocumentsForUser:
DELETE FROM document WHERE user_id = ?;

-- blobs

selectBlob:
SELECT bytes FROM blob WHERE user_id = ? AND kind = ? AND id = ?;

upsertBlob:
INSERT OR REPLACE INTO blob(user_id, kind, id, bytes) VALUES (?, ?, ?, ?);

deleteBlob:
DELETE FROM blob WHERE user_id = ? AND kind = ? AND id = ?;

deleteBlobsForUser:
DELETE FROM blob WHERE user_id = ?;
