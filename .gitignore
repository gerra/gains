*.iml
.gradle
**/build/
xcuserdata
!src/**/build/
local.properties
.idea
.DS_Store
captures
.externalNativeBuild
.cxx
# Xcode: keep only the project file and shared schemes; the embedded workspace and user state are generated.
**/*.xcodeproj/*
!**/*.xcodeproj/project.pbxproj
!**/*.xcodeproj/xcshareddata/
**/xcshareddata/WorkspaceSettings.xcsettings
/iosApp/Pods
*.kotlin_module
.kotlin
# Signing material and build output for TestFlight: never commit these.
*.p8
*.p12
*.mobileprovision
*.xcarchive
*.ipa

# Python bytecode from the scripts in tools/
__pycache__/
*.pyc
# The sync server's secrets and local data (secrets/README.md); only .env.example is tracked.
/secrets/.env
/secrets/.env.*
!/secrets/.env.example
# Google's plist file for Google OAuth
/secrets/*.plist
/server/data/
/data/
